{
  "realm": "shortener",
  "enabled": true,
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "roles": {
    "realm": [
      {
        "name": "user"
      },
      {
        "name": "admin"
      }
    ]
  },
  "clientScopes": [
    {
      "name": "url:manage",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "true"
      }
    },
    {
      "name": "url:clean",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "true"
      }
    }
  ],
  "clients": [
    {
      "clientId": "shortener-client",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "redirectUris": [
        "http://localhost:8080/swagger-ui/*",
        "http://localhost:8080/*"
      ],
      "webOrigins": [
        "http://localhost:8080"
      ],
      "directAccessGrantsEnabled": true,
      "defaultClientScopes": [
        "url:manage"
      ]
    },
    {
      "clientId": "shortener-cron",
      "enabled": true,
      "publicClient": false,
      "secret": "cron-secret",
      "standardFlowEnabled": false,
      "serviceAccountsEnabled": true,
      "clientAuthenticatorType": "client-secret",
      "defaultClientScopes": [
        "url:clean"
      ]
    }
  ],
  "users": [
    {
      "username": "user",
      "enabled": true,
      "email": "testuser@example.com",
      "firstName": "Test",
      "lastName": "User",
      "credentials": [
        {
          "type": "password",
          "value": "user",
          "temporary": false
        }
      ],
      "realmRoles": [
        "user"
      ]
    },
    {
      "username": "service-account-shortener-cron",
      "enabled": true,
      "serviceAccountClientId": "shortener-cron",
      "realmRoles": [
        "admin"
      ]
    }
  ]
}
